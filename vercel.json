{
  "version": 2,
  "name": "resoflex-global-sovereignty",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/assets/(.*)",
      "destination": "https://www.resofit.fit/assets/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "resofit.fit" }],
      "destination": "https://www.resofit.fit/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "resoflex.name.ng" }],
      "destination": "https://www.resofit.fit/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/ui", "destination": "/api/canva_bridge" },
    { "source": "/legal/:path*", "destination": "/pages/legal/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
