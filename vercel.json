{
  "framework": "nextjs",
  "functions": {
    "api/**/*.py": {
      "runtime": "vercel-python@0.1.1"
    },
    "api/**/*.js": {
      "runtime": "vercel-node@latest"
    }
  },
  "rewrites": [
    { "source": "/start", "destination": "/" },
    { "source": "/elite", "destination": "/api/v1/shop/elite" }
  ]
}
