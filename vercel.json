{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/assets/(.*)",
      "destination": "https://www.resofit.fit/assets/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "resoflex.name.ng" }],
      "destination": "https://www.resofit.fit/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/legal/:path*", "destination": "/pages/legal/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Content-Security-Policy", "value": "upgrade-insecure-requests" }
      ]
    }
  ]
}
